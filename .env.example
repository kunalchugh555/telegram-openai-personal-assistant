# Copy this file to .env, fill in your values, and never commit it.

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth credentials (from Google Cloud Console — project: personal-assistant-kunal)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google services config
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKS_LIST_ID=@default

# Bot access control — your Telegram numeric user ID (message @userinfobot to find it)
ALLOWED_USER_ID=your_telegram_user_id_here

# Your location for weather queries and context (e.g. "Chicago, Illinois")
USER_LOCATION=your_city_state_here

# Your timezone (IANA format, e.g. America/Chicago)
USER_TIMEZONE=America/Chicago

# Data directory for token.json and assistant.db
# Leave as . for local development; set to the app directory path on the VM
DATA_DIR=.
