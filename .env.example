# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google services config
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKS_LIST_ID=@default

# Bot access control — your Telegram numeric user ID (message @userinfobot to find it)
ALLOWED_USER_ID=your_telegram_user_id_here

# Data directory for token.json and assistant.db
# Leave as . for local development
# Set to /data on Fly.io
DATA_DIR=.
