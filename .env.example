# Copy this file to .env, fill in your values, and never commit it.

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth credentials (from Google Cloud Console — project: personal-assistant-kunal)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google services config
GOOGLE_CALENDAR_ID=primary
GOOGLE_TASKS_LIST_ID=@default

# Bot access control — your Telegram numeric user ID (message @userinfobot to find it)
ALLOWED_USER_ID=your_telegram_user_id_here

# Your name — used in the assistant's system prompt so it addresses you correctly
USER_NAME=your_name_here

# Your location for weather queries and context (e.g. "Chicago, Illinois")
USER_LOCATION=your_city_state_here

# Your timezone (IANA format, e.g. America/Chicago)
USER_TIMEZONE=America/Chicago

# Your email address — used for the daily rain/snow alert
USER_EMAIL=your_email_here

# Google Maps Platform API key — required for travel time and nearby search
# Enable "Directions API" and "Places API" in Google Cloud Console, then create
# an API key under APIs & Services → Credentials (separate from OAuth).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Data directory for token.json and assistant.db
# Leave as . for local development; set to the app directory path on the VM
DATA_DIR=.
